<% if @issue && !@issue.closed? %>
  <% closed_status = FastCloseStatusResolver.call %>
  <% if closed_status && @issue.new_statuses_allowed_to(User.current).include?(closed_status) %>
    <div id="fast-close-hook">
      <%= link_to l(:button_fast_close), fast_close_issue_path(@issue), method: :post, class: 'icon icon-close' %>
    </div>

    <script>
      (function() {
        var hook = document.getElementById('fast-close-hook');
        if (!hook) return;

        var link = hook.querySelector('a');
        var contextual = document.querySelector('#content > .contextual');
        if (!contextual || !link) return;

        // Place the link between Copy and the actions dropdown.
        var copy = contextual.querySelector('a.icon-copy');
        var dropdown = contextual.querySelector('.drdn');

        if (copy) {
          copy.insertAdjacentElement('afterend', link);
        } else if (dropdown) {
          contextual.insertBefore(link, dropdown);
        } else {
          contextual.appendChild(link);
        }
        hook.remove();
      })();
    </script>
  <% end %>
<% end %>
